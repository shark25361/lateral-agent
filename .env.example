OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
FOURCORE_API_KEY=
FOURCORE_BASE_URL=https://prod.fourcore.io
# Local application credential, distinct from provider keys. Minimum 24 characters.
APP_TOKEN=
LISTEN_ADDR=127.0.0.1:8080
DATA_DIR=data
# Explicitly enable submission after configuring a target allowlist.
EXECUTION_ENABLED=false
ALLOWED_ENDPOINT_ASSETS=
ALLOWED_EMAIL_ASSETS=
# WAF inventory is missing from the published schema. Leave disabled until verified.
ALLOWED_WAF_ASSETS=
ALLOW_ELEVATED=false
LATERAL_EXECUTOR_ENABLED=false
LATERAL_EXECUTOR_BASE_URL=
LATERAL_SOURCE_EXECUTORS=
LATERAL_EXECUTOR_TOKEN=
LATERAL_EVIDENCE_PUBLIC_KEY=
LATERAL_EVIDENCE_PUBLIC_KEYS=
LATERAL_ALLOWED_DESTINATIONS=
LATERAL_CREDENTIAL_REFS=
LATERAL_DEFAULT_CREDENTIAL_REF=
MAX_PLAN_ITEMS=5
MAX_PLAN_ASSETS=10
FOURCORE_RPM=60
POLL_INTERVAL_SECONDS=30
CORRELATION_WAIT_SECONDS=120
